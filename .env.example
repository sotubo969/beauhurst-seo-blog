# Free key from https://aistudio.google.com/apikey
NUXT_GEMINI_API_KEY=
# Comma-separated, tried in order (falls back when a free quota is used up)
NUXT_GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Optional: local LLM via Ollama (used if Gemini is not set or fails)
NUXT_OLLAMA_HOST=http://localhost:11434
NUXT_OLLAMA_MODEL=

# Used for canonical URLs, Open Graph and the sitemap
NUXT_PUBLIC_SITE_URL=http://localhost:3000
